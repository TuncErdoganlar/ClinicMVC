@model IEnumerable<DoctorResponse>
@{
    ViewData["Title"] = "Doctor List";
}
<div class="container-fluid">
    <h1>@ViewData["Title"]</h1>
    <hr />
    <p class="text-danger">@TempData["Message"]</p>
    <div class="row mb-3">
        <div class="col-10 text-success">@Model.Count() record(s) found.</div>
        <div class="col-2 text-end">
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create">Create</a>
            }
        </div>
    </div>
    <table class="table table-striped table-hover">
        <thead class="table-secondary">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FullNameR)</th>
                <th>@Html.DisplayNameFor(model => model.BranchTitleR)</th>
                <th>@Html.DisplayNameFor(model => model.IsExpertR)</th>
                <th>@Html.DisplayNameFor(model => model.PatientCountR)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FullNameR)</td>
                    <td>@Html.DisplayFor(modelItem => item.BranchTitleR)</td>
                    <td>@Html.DisplayFor(modelItem => item.IsExpertR)</td>
                    <td>@Html.DisplayFor(modelItem => item.PatientCountR)</td>
                    <td class="text-end">
                        @* Index is public, but Details needs a logged in user. *@
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            @:&nbsp;|&nbsp;
                            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            @:&nbsp;|&nbsp;
                            <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>